# Public site URL, used for canonicals and hreflang
NEXT_PUBLIC_SITE_URL=https://drjeanobeid.com

# LAUNCH SWITCH. Leave unset until launch: every page then says noindex.
# Set to true only when content is signed off and the domain is live.
ALLOW_INDEXING=

# --- Appointment requests: see src/app/api/appointment-request/route.ts ---
# Email is the delivery path. If these are unset, the form tells patients to
# call or WhatsApp instead of pretending to send.
RESEND_API_KEY=
RESEND_FROM="Appointments <appointments@drjeanobeid.com>"   # domain must be verified in Resend (SPF/DKIM)
CLINIC_NOTIFICATION_EMAIL=

# Request log (name, phone, status only; never the reason). Optional.
# Run supabase/migrations/0001_appointment_requests.sql first. EU region.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp alert to the secretary. Optional. WHATSAPP_TEMPLATE must be a
# pre-approved template with NO parameters, e.g. "New appointment request on
# the website. Please check the clinic email." It must never carry patient data.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_TO=
WHATSAPP_TEMPLATE=

# Analytics. Loaded ONLY after cookie consent. Leave unset to ship no analytics.
NEXT_PUBLIC_GA_ID=
